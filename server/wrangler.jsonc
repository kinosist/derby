{
  "name": "derby",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // 先生用の管理ページ(public/admin/)を配信する
  "assets": { "directory": "./public" },
  // 部屋そのもの。1個だけ使う。
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
